{
  "name": "qusu-editor",
  "version": "1.4.3",
  "private": true,
  "type": "module",
  "description": "QUSU Editor — 微信公众号模块化可视化排版编辑器",
  "author": "Sean He",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "pnpm build && node scripts/build-launcher.mjs && node scripts/start-launcher.mjs",
    "test:desktop": "node scripts/test-desktop.mjs",
    "dist:win": "pnpm build && node scripts/build-launcher.mjs --arch x64,arm64 --package",
    "dist:mac": "pnpm build && node scripts/build-launcher.mjs --arch x64,arm64 --package"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tiptap/core": "3.31.4",
    "@tiptap/react": "^3.6.0",
    "@tiptap/starter-kit": "^3.6.0",
    "dompurify": "^3.2.7",
    "lucide-react": "^0.468.0",
    "nanoid": "^5.1.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
